{
  "name": "@local/dsh-todo-inbox",
  "version": "1.5.0",
  "private": true,
  "description": "@local/dsh-user-attention-and-todo-inbox bundle 的「待办收件箱」组件：注意力组件最终拒绝一次 approval 或 ask_user_question 时，把这次决策收进持久待办而不是丢掉。用户回到 DSH 后可在右侧栏待办页或输入框高亮条审核：批准一次后模型通过 todo_execute 执行原工具（参数从来源会话日志读回并做哈希校验，一次性授权直接跳过注意力门控），或直接回答问题；拒绝的待办可以返回修改，只在应用操作或 AI 调用待办工具时归档。可单独启用，此时 bundle 设置页显示橙色说明。",
  "type": "module",
  "scripts": {
    "test": "node test/todo.test.mjs && node test/client.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "license": "MIT"
}
